# TAK Team Manager -- environment configuration reference.
#
# Deployed on AWS ECS Fargate alongside TAK-NZ's other CDK-managed layers
# (base-infra, auth-infra, tak-infra, CloudTAK, media-infra). CDK resolves
# every variable below and hands it to the SAME running ECS task the same
# way regardless of source -- the container cannot tell whether a value
# arrived as a task-definition `environment`/`secrets` entry or from the S3
# config file; both land in `process.env` identically. The distinction
# below is about WHERE the value is authored, per the user's own model:
# either imported from another stack, or managed locally by this app's own
# stack -- there is no third category.
#
#   PART 1 -- CDK-managed. Resolved by CDK itself and wired directly into
#   the ECS task's `environment`/`secrets` entries. Two cases:
#     (a) imported from ANOTHER stack's CloudFormation export -- a database
#         endpoint, an Authentik token's Secrets Manager ARN, a TAK Server
#         URL (see auth-infra/tak-infra's own `outputs.ts` and
#         `cloudformation-imports.ts` for what they export);
#     (b) managed locally by THIS app's own stack -- a resource it
#         provisions itself (an RDS instance and the Secrets Manager secret
#         RDS generates for it), a secret it synthesizes itself with
#         `generateSecretString` (the same way auth-infra generates its own
#         AuthentikSecretKey -- no human ever chooses the value), or a
#         value it simply knows at synth time (its own ALB hostname, the
#         container port).
#   Changing one of these means changing CDK code/context and redeploying.
#
#   PART 2 -- the deployment config file. Uploaded to the shared S3 config
#   bucket and loaded into the SAME ECS task via
#   `ecs.EnvironmentFile.fromBucket(...)` -- the same mechanism auth-infra's
#   `authentik-config.env`, tak-infra's `takserver-config.env`, and
#   CloudTAK's `cloudtak-config.env` already use. This is where every value
#   that is NEITHER imported from another stack NOR something CDK can
#   generate/know itself belongs -- including a credential CDK cannot
#   synthesize (a Google reCAPTCHA key pair, an SMTP password): creating an
#   empty Secrets Manager entry for CDK to fill in later gains nothing over
#   putting the value directly in this file, and tak-infra's own config
#   file already stores a plaintext secret this same way (its
#   OAuthServer_Secret). Editable by replacing the S3 object and restarting
#   the task -- no CDK redeploy required.
#
#   Most Part 2 entries are optional the same way the other stacks' config
#   files treat their own entries: omit it and the dependent feature is
#   simply inert (e.g. no reCAPTCHA keys -> the challenge can be disabled).
#   The email settings are the one group below that is NOT optional in that
#   sense -- this app relies on outbound email for account verification and
#   notifications, so a real deployment cannot leave it unset the way it
#   can leave reCAPTCHA unset, even though the credential still lives in
#   this same file for the same reason reCAPTCHA's does.
#
# For local development, copy this file to `.env` and fill in values
# directly; there is no CDK stack or S3 file in that environment.

################################################################################
# PART 1 -- CDK-managed: imported from another stack's export, or managed
# locally by this app's own stack
################################################################################

# --- 1a. Imported from another stack: Authentik core credentials
# (auth-infra) ---
AUTHENTIK_URL=https://your-authentik-instance.com
# AUTHENTIK_API_TOKEN: least-privilege service-account token. auth-infra
# provisions the "tak-teammanager-service" account with only the
# Users/Groups/Tokens permissions this app calls (see auth-infra's
# tak-teammanager-setup.yaml blueprint) -- never an Authentik superuser token.
AUTHENTIK_API_TOKEN=your_service_account_token
# AUTHENTIK_ENROLLMENT_ADMIN_TOKEN: a separate Authentik SUPERUSER token,
# read only by server/services/authentik.js's createAppPasswordToken for
# device enrollment. Authentik hard-codes a token's owner to its creating
# user for any non-superuser account, so minting an app-password token for
# a different user requires a superuser token -- sourced from the same
# admin secret auth-infra exports as AuthentikAdminTokenArn (no separate
# secret is created for this). Every other Authentik call uses
# AUTHENTIK_API_TOKEN. If unset, only device enrollment fails.
AUTHENTIK_ENROLLMENT_ADMIN_TOKEN=your_admin_token

# --- 1a. Imported from another stack: Authentik OAuth2 / OIDC (auth-infra,
# from this app's OIDC application) ---
AUTHENTIK_CLIENT_ID=your_oauth_client_id
AUTHENTIK_CLIENT_SECRET=your_oauth_client_secret
AUTHENTIK_TOKEN_URL=https://your-authentik-instance.com/application/o/token/
AUTHENTIK_USERINFO_URL=https://your-authentik-instance.com/application/o/userinfo/
# AUTHENTIK_LOGOUT_URL: this application's OIDC end-session endpoint.
# Optional -- if unset, logout only clears the local session cookie
# without also ending the Authentik SSO session.
AUTHENTIK_LOGOUT_URL=https://your-authentik-instance.com/application/o/your-app-slug/end-session/

# --- 1b. Managed locally: database (this app's own RDS/Aurora construct +
# the Secrets Manager secret RDS generates for it) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tak_team_manager
DB_USER=postgres
DB_PASSWORD=your_password

# --- 1b. Managed locally: secrets this app's own stack synthesizes itself
# with `generateSecretString` -- no human ever chooses the value ---
# JWT_SECRET: signs the session cookie's JWT. Minimum 32 characters.
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
# CREDENTIAL_ENCRYPTION_KEY: base64-encoded 32-byte AES-256-GCM key used by
# server/services/CredentialEncryptionService.js to encrypt BCH service
# account passwords at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=your_base64_encoded_32_byte_key

# --- 1b. Managed locally: application hostnames (this stack's own
# ALB/Route53, once built -- known to CDK at synth time) ---
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- 1a. Imported from another stack: TAK Server integration (tak-infra,
# optional -- leave every variable in this group unset to disable the
# integration entirely) ---
# TAK_SERVER_URL: the Marti certadmin API's mutual-TLS endpoint (an
# internal/admin address, e.g. tak-infra's NLB DNS on 8443). Read by
# server/services/TakServerService.js.
TAK_SERVER_URL=
# TAK_SERVER_ENROLLMENT_URL: the public, client-dialable TAK Server host
# used to build ATAK/iTAK enrollment URIs. DELIBERATELY separate from
# TAK_SERVER_URL above -- they can point at different hosts and/or ports.
# Required for enrollment; left unset, enrollment requests reject with 400.
TAK_SERVER_ENROLLMENT_URL=
# TAK_SERVER_TLS_SERVERNAME: optional. Narrows which name TAK Server's TLS
# certificate is verified against (a stock cert carries only CN=takserver),
# without weakening verification -- the chain is still checked against
# TAK_CA_PATH and rejectUnauthorized is never disabled. Leave unset if the
# certificate already matches the dialed host.
TAK_SERVER_TLS_SERVERNAME=
# TAK_CA_PATH: optional CA bundle path to verify TAK Server's own TLS
# certificate. In the ECS deployment this is a file CDK mounts alongside
# the credential below.
TAK_CA_PATH=
# TAK_ADMIN_CERT_SOURCE: "secrets-manager" reads the TAK Server admin
# mutual-TLS credential (a PKCS#12 bundle) from AWS Secrets Manager via
# TAK_ADMIN_CERT_SECRET_ARN below -- tak-infra exports this secret's ARN
# as TakAdminCertSecretArn. Read by AdminCredentialLoader.js.
TAK_ADMIN_CERT_SOURCE=
# TAK_ADMIN_CERT_SECRET_ARN: required when TAK_ADMIN_CERT_SOURCE is
# "secrets-manager". The Secrets Manager ARN of the PKCS#12 bundle.
TAK_ADMIN_CERT_SECRET_ARN=
#
# Local development only (no equivalent in the ECS deployment -- there is
# no persistent local disk to source a file path from there, so
# TAK_ADMIN_CERT_SOURCE is always "secrets-manager" once this app's CDK
# stack exists): any other value for TAK_ADMIN_CERT_SOURCE above (including
# unset) falls back to reading the credential from a local file/passphrase
# instead, via one of the two pairs below plus an optional passphrase
# override, all read by server/services/TakServerService.js.
TAK_ADMIN_CERT_PASSPHRASE=
TAK_API_P12_PATH=
TAK_API_P12_PASSPHRASE=
TAK_API_CERT_PATH=
TAK_API_KEY_PATH=

# --- 1b. Managed locally: CloudTAK integration (from CDK context shared
# with CloudTAK's own stack -- hostname/zone, not a CloudFormation
# cross-stack import -- optional) ---
# CLOUDTAK_URL: the browser-based CloudTAK client's own deployed URL, if
# CloudTAK is deployed alongside this app. Leave unset if not deployed --
# the Downloads page then omits the CloudTAK row entirely.
CLOUDTAK_URL=

# --- 1b. Managed locally: secrets provider mode ---
# SECRETS_PROVIDER: "aws-secrets-manager" resolves AUTHENTIK_API_TOKEN,
# JWT_SECRET, DB_PASSWORD, and EMAIL_PASSWORD by calling AWS Secrets
# Manager for each at startup, instead of trusting the value already
# present in process.env. Leave unset for local/dev/test (the default
# EnvSecretsProvider then just reads process.env directly, which is also
# what happens in the ECS deployment once every one of those four values
# is already a literal in process.env -- whether placed there by ECS's own
# `secrets` resolution or, for EMAIL_PASSWORD, by the Part 2 S3 file).
SECRETS_PROVIDER=
# AWS_REGION: standard AWS SDK region variable, consulted only when
# SECRETS_PROVIDER=aws-secrets-manager.
AWS_REGION=

# --- 1b. Managed locally: runtime, known to this app's own stack at
# synth time ---
PORT=3000
# NODE_ENV: must be exactly "production", "development", or "test" if set --
# validated at startup. Several security-relevant behaviors (session
# cookie Secure flag, reCAPTCHA test bypass, DB TLS verification) key off
# an exact 'production' string match.
NODE_ENV=development
# TRUSTED_PROXY_HOPS: reverse-proxy hop count Express trusts when resolving
# req.ip from X-Forwarded-For, governing every IP-keyed rate limiter.
# Deliberately a hop COUNT, never "true" (which would trust a
# caller-forged header). Determined by this stack's own network topology
# (whether an ALB, and a CDN in front of it, exist) -- set to 1 once this
# stack's own ALB exists with no CDN in front of it, paired with a
# security group restricting the container port to the ALB's security
# group only. Defaults to 0 (correct for local/dev/test, where nothing
# sits in front of the app).
TRUSTED_PROXY_HOPS=0

# --- 1b. Managed locally: client build (Vite) -- baked into the bundle by
# `vite build` during the image build, so neither ECS `environment`/
# `secrets` entries nor the Part 2 S3 file can reach these (both only
# affect the RUNNING container, and this is consumed before the container
# exists). Supplied as Docker build args by the image-build step instead. ---
# VITE_API_BASE_URL: backend base URL for the built client bundle. Defaults
# to a same-origin relative path when unset.
VITE_API_BASE_URL=
# VITE_DEV_PROXY_TARGET: backend target the Vite dev server proxies /api
# to. Only used by `vite dev`, never by the production build.
VITE_DEV_PROXY_TARGET=http://localhost:3000
# VITE_START_OVER_URL: where the sign-up confirmation screen's "Start
# over" link navigates. Defaults to reloading /request-access.
VITE_START_OVER_URL=https://tak.nz

################################################################################
# PART 2 -- the deployment config file (S3, loaded via
# ecs.EnvironmentFile.fromBucket into the SAME ECS task; editable by
# replacing the S3 object and restarting the task, no CDK redeploy)
################################################################################

# --- Third-party credentials CDK cannot generate and no other stack
# exports (see the file header -- these belong here, not in Secrets
# Manager, for the same reason tak-infra's own OAuthServer_Secret does).
# Optional: each dependent feature is simply inert if left unset. ---
# Google reCAPTCHA v3: needs both keys from the SAME key pair
# (https://www.google.com/recaptcha/admin). RECAPTCHA_SITE_KEY is safe to
# expose publicly; RECAPTCHA_SECRET must never reach the client. Leaving
# both unset does not disable the challenge itself -- see
# RECAPTCHA_DISABLED below for that -- but the challenge cannot succeed
# without a real key pair.
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET=your_recaptcha_secret_key
# RECAPTCHA_MIN_SCORE: minimum risk score (0.0-1.0) to pass. Default 0.5.
RECAPTCHA_MIN_SCORE=0.5
# RECAPTCHA_DISABLED: testing-only bypass. Hard-disabled whenever
# NODE_ENV=production regardless of this value. Leave "false" normally.
RECAPTCHA_DISABLED=false

# --- Outbound email / SMTP: NOT optional in practice (this app relies on
# email for account verification and admin notifications), even though the
# credential lives here for the same reason reCAPTCHA's does -- works with
# any SMTP-compatible provider (AWS SES's SMTP interface, Authentik's own
# relay, SendGrid, Mailgun, a self-hosted relay). ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
# EMAIL_USE_TLS: STARTTLS upgrade. Default true.
EMAIL_USE_TLS=true
# EMAIL_USE_SSL: implicit TLS from the start (SMTPS), typically with port
# 465. Default false. When true, EMAIL_USE_TLS is not consulted.
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
EMAIL_FROM="TAK Team Manager <noreply@yourdomain.com>"

# --- Feature flags (server-side only; each defaults to false unless noted,
# and is enabled ONLY for the exact string "true" -- "TRUE"/"1" leave the
# feature inert) ---
# CLOUDTAK_ENABLED: mirrors every Team/Organisation into an Authentik LDAP
# group (CloudTAKAgency<id>) via the sync queue. Independent of CLOUDTAK_URL
# above. Never exposed via GET /api/config/public.
CLOUDTAK_ENABLED=false
# CLOUDTAK_AGENCY_GROUP_PREFIX: group-name prefix for the groups above.
# Must match CloudTAK's own OIDC_AGENCY_ADMIN_GROUP_PREFIX -- the two apps
# share no config source, so a mismatch silently breaks agency-admin sync.
# Defaults to "CloudTAKAgency".
CLOUDTAK_AGENCY_GROUP_PREFIX=CloudTAKAgency
# DEVICE_MGMT_ENABLED: turns on TAK device (client certificate) visibility
# and revocation UI/routes. Feature-off answers 404, not 403.
DEVICE_MGMT_ENABLED=false
# DEVICE_MGMT_REVOKE_ENABLED: arms the DESTRUCTIVE half of device
# management -- actually issuing a certificate revocation. Independent of
# DEVICE_MGMT_ENABLED (never derived from it), so viewing devices does not
# also arm revocation. Disarmed answers 403; a queued revoke completes as a
# logged dry-run.
DEVICE_MGMT_REVOKE_ENABLED=false
# CERT_EXPIRY_NOTIFICATIONS_ENABLED: daily certificate-expiry email digest.
# Requires DEVICE_MGMT_ENABLED to ALSO be exactly "true".
CERT_EXPIRY_NOTIFICATIONS_ENABLED=false
# FORCE_SSO_LOGIN: skips the manual "Sign in" click and starts the OAuth2
# redirect immediately. Presentation only -- does not bypass authentication.
FORCE_SSO_LOGIN=false

# --- Database tuning ---
# DB_POOL_MAX: max database connection pool size. Default 20.
DB_POOL_MAX=20
# DB_CA_PATH: PEM CA bundle for verifying the database's TLS certificate.
# Only needed for a database whose certificate does not chain to a public
# root -- a managed database with a public CA (e.g. AWS RDS) needs
# nothing here. No effect outside production.
DB_CA_PATH=

# --- Sync engine tuning ---
# AUTHENTIK_SYNC_ENABLED: operational kill-switch for the periodic Authentik
# user sync AND its reconciliation sweep (the pass that marks a local user
# 'orphaned' when it is absent from Authentik). Opt-OUT, not the usual
# 'true'-only flag: the sync runs by default and is disabled ONLY when this is
# exactly 'false'. Set to 'false' to halt the sweep during a bulk import or an
# Authentik maintenance window, where a partial/errored Authentik fetch would
# otherwise false-orphan real users. Default (unset) leaves the sync running.
AUTHENTIK_SYNC_ENABLED=true
# SYNC_INTERVAL_MINUTES: minutes between AuthentikSyncService reconciliation
# sweeps. Floor-clamped to 1. Default 10.
SYNC_INTERVAL_MINUTES=10
# SYNC_WORKER_BATCH_SIZE: sync_operations rows fetched per Sync_Worker poll.
# Clamped 10-500. Default 50.
SYNC_WORKER_BATCH_SIZE=50
# SYNC_WORKER_CONCURRENCY: concurrent same-entity lanes per batch. Clamped
# 1-100. Default 10. May be set lower than SYNC_WORKER_BATCH_SIZE.
SYNC_WORKER_CONCURRENCY=10
# AUTHENTIK_SYNC_CONCURRENCY: concurrent users processed per sync batch.
# Clamped 1-20. Default 5.
AUTHENTIK_SYNC_CONCURRENCY=5
# --- Authentik API rate limiting ---
# Shared, cross-process throttle on every call TAK Team Manager makes to
# the Authentik management API. Ceilings are requests/second and were
# derived from load-profiling a prod-shaped Authentik (see
# docs/authentik-ratelimit-profiling.md): Authentik returns NO 429 here --
# it degrades into latency/timeouts once reads exceed ~5-8 rps or writes
# exceed ~3-5 rps -- so these defaults sit deliberately below that.
# AUTHENTIK_RATE_LIMIT_ENABLED: true ONLY for the exact string "true".
# When false (default), the limiter is a transparent pass-through.
AUTHENTIK_RATE_LIMIT_ENABLED=false
# AUTHENTIK_RATE_LIMIT_READ_PER_SEC: read (GET) ceiling. Positive int, default 5.
AUTHENTIK_RATE_LIMIT_READ_PER_SEC=5
# AUTHENTIK_RATE_LIMIT_WRITE_PER_SEC: normal write (POST/PATCH/DELETE)
# ceiling. Positive int, default 3 (the conservative serverless-DB-safe value).
# A prod-CLASS Authentik database has been measured to safely sustain 4 (see
# docs/authentik-ratelimit-profiling.md's 2026-09 follow-up) -- raise to 4 only
# when you know the deployment runs a prod-class DB, not on serverless.
AUTHENTIK_RATE_LIMIT_WRITE_PER_SEC=3
# AUTHENTIK_RATE_LIMIT_WRITE_PRIORITY_PER_SEC: reserved write budget for
# urgent mutations (delete/suspend/revoke/cleanup) so they get a token even
# while a bulk background job has drained the normal write budget. Positive
# int, default 2. WRITE + WRITE_PRIORITY together stay at/under the ~5/s
# clean write ceiling.
AUTHENTIK_RATE_LIMIT_WRITE_PRIORITY_PER_SEC=2
# --- Group-authoritative membership reconciler (Phase 2) ---
# Computes an owned Authentik group's COMPLETE desired member set from the
# local DB and writes it with a single full-replace group PATCH, replacing
# the per-user add/remove fan-out. Ships dark.
# BULK_GROUP_RECONCILE_ENABLED: true ONLY for the exact string "true". When
# false (default), the reconcile_owned_group worker op is an inert no-op.
BULK_GROUP_RECONCILE_ENABLED=false
# BULK_GROUP_RECONCILE_DRY_RUN: INVERTED default -- dry-run is ON unless this
# is exactly "false". While ON, the reconciler computes and LOGS the desired
# members but issues NO Authentik write. Set to "false" only AFTER validating
# the logged diffs against real Authentik state, to arm real writes.
BULK_GROUP_RECONCILE_DRY_RUN=true
# OWNED_GROUP_SWEEP_ENABLED: periodic anti-drift sweep that enqueues a
# reconcile for EVERY owned group, correcting any drift a missed event left
# behind. true ONLY for the exact string "true". Pointless without
# BULK_GROUP_RECONCILE_ENABLED (the reconcile handler no-ops while that is
# off), so the sweep is gated on BOTH.
OWNED_GROUP_SWEEP_ENABLED=false
# OWNED_GROUP_SWEEP_INTERVAL_MINUTES: minutes between sweeps. Floor-clamped
# to 1. Default 60. The sweep only ENQUEUES (cheap); the rate-limited worker
# drains at the Authentik write ceiling, so this governs drift-check
# frequency, not write speed.
OWNED_GROUP_SWEEP_INTERVAL_MINUTES=60
# AUTHENTIK_SYNC_IGNORED_USERNAME_PREFIXES: comma-separated Authentik
# username prefixes (e.g. "etl-,ak-,ldapservice") skipped entirely by sync
# and by GET /api/users -- for service/ETL accounts with no email that
# would otherwise fail the users_email_required_unless_device check every
# cycle. Case-sensitive exact-prefix match; a full username also matches.
# Defaults to unset (skips nothing).
AUTHENTIK_SYNC_IGNORED_USERNAME_PREFIXES=
# SYNC_WORKER_HEALTH_PORT: port for the Sync_Worker's health endpoint
# (200 while its heartbeat is under 90s old, 503 otherwise). Default 3001.
SYNC_WORKER_HEALTH_PORT=3001
# TAK_ADMIN_CERT_REFRESH_INTERVAL_SECONDS: interval between reloads of the
# cached TAK Server admin credential, so a rotated credential applies
# without a restart. Floor-clamped to 60. Default 86400 (24h).
TAK_ADMIN_CERT_REFRESH_INTERVAL_SECONDS=86400
# DEVICE_MGMT_POLL_INTERVAL_SECONDS: interval between SubscriptionPoller
# connection-status/last-seen polls. Floor-clamped to 60. Default 300 (5m).
DEVICE_MGMT_POLL_INTERVAL_SECONDS=300
# DEVICE_MGMT_SYNC_INTERVAL_SECONDS: interval between DeviceSync
# certificate-metadata refreshes. Clamped 60-86400. Default 900 (15m).
DEVICE_MGMT_SYNC_INTERVAL_SECONDS=900
# DEVICE_MGMT_REVOKE_MAX_CERTS: blast-radius cap on a single revoke
# operation -- exceeding it aborts the whole operation rather than
# truncating (a partial revoke would report a device disabled while still
# connectable). Default 250.
DEVICE_MGMT_REVOKE_MAX_CERTS=250

# --- Retention ---
# RETENTION_CLEANUP_INTERVAL_SECONDS: interval between RetentionCleanupJob
# passes, which delete expired sync_operations/audit_logs rows per the two
# settings below. Floor-clamped to 60. Default 86400 (24h).
RETENTION_CLEANUP_INTERVAL_SECONDS=86400
# SYNC_OPERATIONS_RETENTION_DAYS: days a terminal sync_operations row is
# kept. Default 90.
SYNC_OPERATIONS_RETENTION_DAYS=90
# AUDIT_LOGS_RETENTION_DAYS: days an audit_logs row is kept (audit_logs is
# otherwise append-only). Must exceed SYNC_OPERATIONS_RETENTION_DAYS.
# Default 365.
AUDIT_LOGS_RETENTION_DAYS=365

# --- TAK colour / role labels (deployment vocabulary) ---
TAK_COLOR_YELLOW=Your Organization Name
TAK_COLOR_CYAN=Your Organization Name
TAK_COLOR_GREEN=Your Organization Name
TAK_COLOR_RED=Your Organization Name
TAK_COLOR_PURPLE=Your Organization Name
TAK_COLOR_ORANGE=Your Organization Name
TAK_COLOR_BLUE=Your Organization Name
TAK_COLOR_MAGENTA=
TAK_COLOR_WHITE=Your Organization Name
TAK_COLOR_MAROON=Your Organization Name
TAK_COLOR_DARK_BLUE=Your Organization Name
TAK_COLOR_TEAL=Your Organization Name
TAK_COLOR_DARK_GREEN=
TAK_COLOR_BROWN=Your Organization Name
TAK_ROLE_TEAM_MEMBER=The default role for all personnel who do not better fit in one of the other roles
TAK_ROLE_TEAM_LEAD=First-line supervisors and above
TAK_ROLE_SNIPER=SWAT, special response teams, and snipers
TAK_ROLE_MEDIC=Personnel with EMT training and equipment or greater
TAK_ROLE_FORWARD_OBSERVER=Observation post personnel, UAS remote pilots, and tactical flight officers
TAK_ROLE_RTO=(Radio Telephone Operator) Communications personnel: telecommunicators, dispatch, communications unit leaders, and communications unit technicians
TAK_ROLE_K9=K9 personnel
TAK_ROLE_HQ=Headquarters, incident command post, and emergency operations center personnel

# --- Presentation & branding (all optional; each arms no capability) ---
ADMIN_GROUP_NAME=TakTeamManager_Admin
# CHANNEL_FOLDER_SEPARATOR: joins hierarchical channel/group display names
# (e.g. "Parent - Child").
CHANNEL_FOLDER_SEPARATOR=" - "
# TOS_URL: shown as a required checkbox link on the public sign-up form. If
# unset, the checkbox is not shown.
TOS_URL=
# DOCS_URL: linked as {{docs_url}} in the approval email and on the client.
DOCS_URL=
# ACCOUNT_LOGIN_URL: linked as {{login_url}} in the approval email.
ACCOUNT_LOGIN_URL=
# PASSWORD_RESET_URL: linked as {{password_reset_url}} in the approval and
# already-active-signup emails.
PASSWORD_RESET_URL=
# WINTAK_MANUAL_DESCRIPTION: label shown as "Description" on the
# Enrollment page's WinTAK/Manual tab. Defaults to "TAK.NZ".
WINTAK_MANUAL_DESCRIPTION=TAK.NZ

# --- Date display (app-wide; presentation only -- stored/logged/API
# timestamps stay ISO-8601 UTC regardless) ---
# DISPLAY_TIMEZONE: IANA zone every user-visible date is rendered in.
# Defaults to Pacific/Auckland; an unrecognised zone falls back the same way.
DISPLAY_TIMEZONE=Pacific/Auckland
# DISPLAY_LOCALE: BCP 47 tag used only to resolve the short timezone
# abbreviation shown alongside each date (e.g. "NZST" vs "GMT+12"; the
# numeric date/time itself is locale-independent). Defaults to "en-NZ".
DISPLAY_LOCALE=en-NZ

# --- Daily digest schedule (shared by the admin-notification digest and
# the certificate-expiry digest) ---
# DIGEST_HOUR / DIGEST_MINUTE / DIGEST_TIMEZONE: local time, checked once a
# minute, at which both daily digests run. Re-read on every check, so a
# change takes effect without a restart. Default 9:00 Pacific/Auckland.
DIGEST_HOUR=9
DIGEST_MINUTE=0
DIGEST_TIMEZONE=Pacific/Auckland

# --- Device management: presentation-only tuning ---
# DEVICE_MGMT_EXPIRY_WARNING_DAYS: days ahead of expiry a device's
# "Expires" value is drawn as imminent (bold/red/screen-reader marker).
# Client-exposed (unlike the device-management flags above) because it only
# affects how a date is drawn -- it filters no query and revokes nothing.
# Default 30.
DEVICE_MGMT_EXPIRY_WARNING_DAYS=30

# --- Certificate expiry notification thresholds ---
# CERT_EXPIRY_TIER1_DAYS..TIER4_DAYS: four day-count thresholds against a
# certificate's remaining life. Tier 1 (least urgent) notifies only the
# device's own team's admins; tier 4 (most urgent) reaches the whole
# Ancestor_Chain up to the Organisation. Defaults 30/15/8/1.
CERT_EXPIRY_TIER1_DAYS=30
CERT_EXPIRY_TIER2_DAYS=15
CERT_EXPIRY_TIER3_DAYS=8
CERT_EXPIRY_TIER4_DAYS=1
# CERT_EXPIRY_ACTIVITY_WINDOW_DAYS: a device is only eligible for a
# notification if last seen (or issued) within this many days of its
# certificate's expiry -- keeps an abandoned test enrollment from
# generating a notification. Default 90.
CERT_EXPIRY_ACTIVITY_WINDOW_DAYS=90

# --- File upload paths ---
# UPLOADS_DIR: where branding logo uploads are written; served over HTTP at
# /uploads. Defaults to server/uploads/branding.
UPLOADS_DIR=
# CERTS_DIR: where TAK Server cert/key uploads are written. NOT served over
# HTTP. Defaults to server/certs/tak-server.
CERTS_DIR=

# --- Logging ---
# LOG_LEVEL: one of debug, info, warn, error. Default info.
LOG_LEVEL=info
