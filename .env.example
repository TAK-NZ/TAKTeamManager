# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tak_team_manager
DB_USER=postgres
DB_PASSWORD=your_password

# Authentik Configuration
AUTHENTIK_URL=https://your-authentik-instance.com
AUTHENTIK_ADMIN_TOKEN=your_admin_token

# Authentik OAuth2 Configuration
AUTHENTIK_CLIENT_ID=your_oauth_client_id
AUTHENTIK_CLIENT_SECRET=your_oauth_client_secret
AUTHENTIK_AUTHORIZE_URL=https://your-authentik-instance.com/application/o/authorize/
AUTHENTIK_TOKEN_URL=https://your-authentik-instance.com/application/o/token/
AUTHENTIK_USERINFO_URL=https://your-authentik-instance.com/application/o/userinfo/

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h

# Email Configuration (for notifications)
SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=<your_ses_username>
SMTP_PASS=<your_ses_password>

# Application Configuration
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173