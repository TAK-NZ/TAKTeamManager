# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tak_team_manager
DB_USER=postgres
DB_PASSWORD=your_password

# Authentik Configuration
AUTHENTIK_URL=https://your-authentik-instance.com
AUTHENTIK_ADMIN_TOKEN=your_admin_token

# Authentik Email Configuration
AUTHENTIK_EMAIL__HOST=email-smtp.ap-southeast-2.amazonaws.com
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=your_ses_username
AUTHENTIK_EMAIL__PASSWORD=your_ses_password
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__FROM="TAK Team Manager <noreply@yourdomain.com>"

# Authentik OAuth2 Configuration
AUTHENTIK_CLIENT_ID=your_oauth_client_id
AUTHENTIK_CLIENT_SECRET=your_oauth_client_secret
AUTHENTIK_AUTHORIZE_URL=https://your-authentik-instance.com/application/o/authorize/
AUTHENTIK_TOKEN_URL=https://your-authentik-instance.com/application/o/token/
AUTHENTIK_USERINFO_URL=https://your-authentik-instance.com/application/o/userinfo/

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Email Configuration (for notifications)
SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=your_ses_username
SMTP_PASS=your_ses_password

# Application Configuration
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Admin Configuration
ADMIN_GROUP_NAME=TakTeamManager_Admin

# TAK Color Mappings
TAK_COLOR_YELLOW=Your Organization Name
TAK_COLOR_CYAN=Your Organization Name
TAK_COLOR_GREEN=Your Organization Name
TAK_COLOR_RED=Your Organization Name
TAK_COLOR_PURPLE=Your Organization Name
TAK_COLOR_ORANGE=Your Organization Name
TAK_COLOR_BLUE=Your Organization Name
TAK_COLOR_MAGENTA=
TAK_COLOR_WHITE=Your Organization Name
TAK_COLOR_MAROON=Your Organization Name
TAK_COLOR_DARK_BLUE=Your Organization Name
TAK_COLOR_TEAL=Your Organization Name
TAK_COLOR_DARK_GREEN=
TAK_COLOR_BROWN=Your Organization Name

# TAK Role Descriptions
TAK_ROLE_TEAM_MEMBER=The default role for all personnel who do not better fit in one of the other roles
TAK_ROLE_TEAM_LEAD=First-line supervisors and above
TAK_ROLE_SNIPER=SWAT, special response teams, and snipers
TAK_ROLE_MEDIC=Personnel with EMT training and equipment or greater
TAK_ROLE_FORWARD_OBSERVER=Observation post personnel, UAS remote pilots, and tactical flight officers
TAK_ROLE_RTO=(Radio Telephone Operator) Communications personnel: telecommunicators, dispatch, communications unit leaders, and communications unit technicians
TAK_ROLE_K9=K9 personnel
TAK_ROLE_HQ=Headquarters, incident command post, and emergency operations center personnel

# Sync Configuration
SYNC_INTERVAL_MINUTES=10