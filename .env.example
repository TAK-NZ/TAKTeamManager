# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tak_team_manager
DB_USER=postgres
DB_PASSWORD=your_password
# Maximum connection pool size for the App's database pool (server/config/database.js).
# Defaults to 20 if unset.
DB_POOL_MAX=20

# TRUSTED_PROXY_HOPS: the number of reverse-proxy hops Express should trust
# when resolving req.ip/req.ips from an incoming X-Forwarded-For header, and
# when detecting HTTPS from X-Forwarded-Proto (server/config/trustProxy.js's
# getTrustProxyHops, applied via app.set('trust proxy', ...) in
# server/index.js). This governs every req.ip-keyed rate limiter
# (server/middleware/rateLimiters.js's authFlowLimiter,
# requestAccessLimiter, etc.) and helmet's HSTS behavior.
#
# Defaults to 0 (trust nothing) -- correct for local/dev/test, where no
# proxy sits in front of the App. Deliberately a HOP COUNT, never "true":
# `true` trusts the entire X-Forwarded-For chain including a caller-forged
# prefix, which would let a client defeat every IP-keyed rate limiter by
# rotating a fake header value per request.
#
# TODO(CDK deployment): once deployed to production behind the ALB (see
# README.md's Deployment section -- the CDK stack for this is a documented
# follow-up, not yet implemented), set this to 1 -- exactly one trusted
# hop, the ALB itself, with no CDN in front of it. If a CDN (e.g.
# CloudFront) is ever added in front of the ALB, this must become 2. This
# value is meaningful ONLY if paired with an ECS security group rule that
# accepts inbound traffic on the container port exclusively from the ALB's
# security group (never 0.0.0.0/0 or a broad VPC CIDR) -- otherwise a
# request could reach the App directly and forge X-Forwarded-For itself.
# See BUGS.md NOTE-001.
TRUSTED_PROXY_HOPS=0

# Authentik Configuration
AUTHENTIK_URL=https://your-authentik-instance.com
# AUTHENTIK_API_TOKEN: an Authentik API token for a dedicated,
# least-privilege service account (auth-infra provisions
# "tak-teammanager-service" with exactly the Users/Groups/Tokens
# permissions this app's code calls -- see auth-infra's
# tak-teammanager-setup.yaml blueprint). Deliberately NOT an Authentik
# superuser/admin token: this app never touches Applications, Providers,
# Outposts, Flows, Stages, or Policies, so it should not hold a token
# that could.
AUTHENTIK_API_TOKEN=your_service_account_token

# AUTHENTIK_ENROLLMENT_ADMIN_TOKEN: a SEPARATE Authentik SUPERUSER/admin
# token, read only by server/services/authentik.js's
# createAppPasswordToken (device enrollment: server/services/
# DeviceEnrollmentService.js's generateSelfEnrollment/
# generateEnrollmentQrCode). This is a deliberate, isolated exception to
# the least-privilege AUTHENTIK_API_TOKEN above -- Authentik's
# TokenViewSet.perform_create (core/api/tokens.py) unconditionally forces
# a token created via POST /core/tokens/ to be owned by the CALLER for
# any non-superuser account; that check is not permission-gated, so no
# grant to the scoped role can make it create a token for a different
# user. Enrollment needs exactly that (an app-password token scoped to
# the enrolling device's or human's OWN Authentik user, not to a service
# account), so this one call site keeps using a superuser token, sourced
# from the SAME admin secret auth-infra already exports as
# AuthentikAdminTokenArn (no new secret is created for this). Every other
# Authentik call in this app uses AUTHENTIK_API_TOKEN and must never read
# this variable. If unset, device enrollment fails with a clear error
# rather than silently sending an unauthenticated request; every other
# feature is unaffected.
AUTHENTIK_ENROLLMENT_ADMIN_TOKEN=your_admin_token

# Authentik OAuth2 Configuration
AUTHENTIK_CLIENT_ID=your_oauth_client_id
AUTHENTIK_CLIENT_SECRET=your_oauth_client_secret
AUTHENTIK_TOKEN_URL=https://your-authentik-instance.com/application/o/token/
AUTHENTIK_USERINFO_URL=https://your-authentik-instance.com/application/o/userinfo/
# AUTHENTIK_LOGOUT_URL: Authentik's OIDC end-session endpoint for this
# application (Application slug-specific -- find it under the
# application's "Logout URL"/end-session endpoint in the Authentik admin
# UI, typically
# https://your-authentik-instance.com/application/o/<app-slug>/end-session/).
# Optional -- if unset, logout only clears the local session cookie and
# redirects to FRONTEND_URL instead of also ending the Authentik SSO
# session.
AUTHENTIK_LOGOUT_URL=https://your-authentik-instance.com/application/o/your-app-slug/end-session/

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Application Configuration
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Admin Configuration
ADMIN_GROUP_NAME=TakTeamManager_Admin

# Channel Configuration
# Separator used when building hierarchical channel/group display names
# (e.g. "Parent - Child"). Read by server/models/Team.js, server/models/Channel.js,
# server/services/GlobalChannelService.js, server/models/SiteConfig.js,
# server/routes/channels.js, and server/workers/syncWorker.js.
CHANNEL_FOLDER_SEPARATOR=" - "

# Date Display
# DISPLAY_TIMEZONE: optional. IANA timezone name (e.g. "Pacific/Auckland",
# "Australia/Sydney", "UTC") that every user-visible date in the application is
# rendered in. Read by server/models/SiteConfig.js's getPublicConfig() and
# exposed via GET /api/config/public as display_timezone, which the Client's
# shared date formatters (client/src/utils/dateFormat.js) render from. Defaults
# to Pacific/Auckland if unset or empty; the Client falls back to the same
# default when it cannot reach that endpoint.
#
# APP-WIDE, NOT DEVICE-MANAGEMENT-ONLY: this applies to EVERY date the
# application shows -- the device lists, the Users view, the audit log, the
# requests lists, the admin surfaces, the org-interest requests. Changing it
# shifts dates on pages that have nothing to do with device management. That is
# deliberate: a per-feature timezone would put two dates on one screen in two
# different zones.
#
# PRESENTATION ONLY: this changes how an instant is DRAWN and nothing else.
# Timestamps are still stored, logged, and carried in API responses exactly as
# they are today (ISO-8601, UTC). No stored value, no log field, and no API
# response field is converted into this zone.
#
# A zone name this application's runtime does not recognise costs the
# application its configured zone and nothing else -- rendering falls back to
# Pacific/Auckland, then UTC, and never fails.
DISPLAY_TIMEZONE=Pacific/Auckland

# DISPLAY_LOCALE: optional. A BCP 47 locale tag (e.g. "en-NZ", "en-US",
# "en-AU") consulted ONLY to resolve the short timezone abbreviation (e.g.
# "NZST", "PDT", "GMT+12") appended to every date-and-time value the Client
# renders. Read by server/models/SiteConfig.js's getPublicConfig() and
# exposed via GET /api/config/public as display_locale.
#
# WHY THIS EXISTS SEPARATELY FROM DISPLAY_TIMEZONE: the same IANA zone's
# short abbreviation is locale-dependent -- Pacific/Auckland resolves to
# "NZST"/"NZDT" under "en-NZ" but to the less legible "GMT+12" under
# "en-US". The numeric yyyy-mm-dd HH:MM components rendered alongside it are
# NOT affected by this value and stay locale-independent (still assembled by
# client/src/utils/dateFormat.js itself, never handed to a locale-aware
# formatter for that part).
#
# Defaults to "en-NZ" if unset or empty; the Client falls back to the same
# default when it cannot reach this endpoint. An unrecognised locale tag
# falls back to the same default and never fails.
DISPLAY_LOCALE=en-NZ

# TAK Color Mappings
TAK_COLOR_YELLOW=Your Organization Name
TAK_COLOR_CYAN=Your Organization Name
TAK_COLOR_GREEN=Your Organization Name
TAK_COLOR_RED=Your Organization Name
TAK_COLOR_PURPLE=Your Organization Name
TAK_COLOR_ORANGE=Your Organization Name
TAK_COLOR_BLUE=Your Organization Name
TAK_COLOR_MAGENTA=
TAK_COLOR_WHITE=Your Organization Name
TAK_COLOR_MAROON=Your Organization Name
TAK_COLOR_DARK_BLUE=Your Organization Name
TAK_COLOR_TEAL=Your Organization Name
TAK_COLOR_DARK_GREEN=
TAK_COLOR_BROWN=Your Organization Name

# TAK Role Descriptions
TAK_ROLE_TEAM_MEMBER=The default role for all personnel who do not better fit in one of the other roles
TAK_ROLE_TEAM_LEAD=First-line supervisors and above
TAK_ROLE_SNIPER=SWAT, special response teams, and snipers
TAK_ROLE_MEDIC=Personnel with EMT training and equipment or greater
TAK_ROLE_FORWARD_OBSERVER=Observation post personnel, UAS remote pilots, and tactical flight officers
TAK_ROLE_RTO=(Radio Telephone Operator) Communications personnel: telecommunicators, dispatch, communications unit leaders, and communications unit technicians
TAK_ROLE_K9=K9 personnel
TAK_ROLE_HQ=Headquarters, incident command post, and emergency operations center personnel

# Sync Configuration
# Interval, in minutes, between AuthentikSyncService periodic reconciliation
# sweeps (server/services/authentikSync.js's startPeriodicSync). Clamped to
# a 1-minute floor; there is no upper bound. Defaults to 10 if unset.
SYNC_INTERVAL_MINUTES=10
# Number of pending sync_operations rows fetched per Sync_Worker polling
# cycle (server/workers/syncWorker.js's processNextOperation), via
# `LIMIT $1` with FOR UPDATE SKIP LOCKED. Accepts an integer between 10
# and 500 inclusive; values outside that range are clamped, and a
# missing/non-numeric value defaults to 50.
SYNC_WORKER_BATCH_SIZE=50
# Maximum number of same-entity "lanes" (see groupByEntityKey in
# server/workers/entityGrouping.js) processed concurrently within a single
# fetched batch by the Sync_Worker's processNextOperation, via a
# p-limit-bounded worker pool. Operations sharing the same
# target_user_id:target_group_id pair always stay on one lane and run
# strictly sequentially and in fetch order relative to each other,
# regardless of this setting. Accepts an integer between 1 and 100
# inclusive; values outside that range are clamped, and a missing/
# non-numeric value defaults to 10. This is independent of
# SYNC_WORKER_BATCH_SIZE above -- it MAY be set lower than the batch size.
SYNC_WORKER_CONCURRENCY=10
# Maximum number of users processed concurrently within a single batch by
# AuthentikSyncService.processBatch (server/services/authentikSync.js), via
# a p-limit-bounded worker pool instead of a fully serial loop. Accepts an
# integer between 1 and 20 inclusive; values outside that range are
# clamped, and a missing/non-numeric value defaults to 5.
AUTHENTIK_SYNC_CONCURRENCY=5
# AUTHENTIK_SYNC_IGNORED_USERNAME_PREFIXES: optional, comma-separated list
# of Authentik username prefixes (e.g. "etl-,svc-") that
# AuthentikSyncService.syncSingleUser (server/services/authentikSync.js,
# server/config/authentikSyncIgnore.js) skips entirely -- no INSERT INTO
# users or user_cache is attempted for a matching account. Intended for
# ETL/service accounts that have no email address and are not TAK Team
# Manager Team_Owned_Devices: without this, every sync cycle attempts the
# users upsert for such an account, always violates the
# users_email_required_unless_device CHECK constraint, and relies on
# catching that Postgres error to skip it -- correct in outcome, but a
# guaranteed rejected statement (logged as an ERROR by Postgres itself,
# regardless of the catch) every cycle, forever. Matching is case-sensitive
# exact-prefix (String.prototype.startsWith); each entry is trimmed of
# surrounding whitespace, and an empty entry (e.g. a trailing comma) is
# dropped rather than matching every username. Defaults to unset/empty,
# which skips no accounts -- the pre-existing catch-and-warn behavior on
# users_email_required_unless_device remains as a safety net for any
# emailless, non-prefixed, non-device account either way.
# Bugfix: GET /api/users (server/routes/users.js) now ALSO applies this
# same predicate, filtering such accounts out of the Users view entirely
# -- fetched directly from Authentik's /core/users/?type=internal, so an
# account excluded from local sync above would otherwise still appear in
# the list. A plain, prefix-free username (e.g. "akadmin", "ckadmin") may
# be listed here too: startsWith matches an exact full username just as
# well as a true prefix.
AUTHENTIK_SYNC_IGNORED_USERNAME_PREFIXES=
# Port for the Sync_Worker's lightweight http.createServer health endpoint
# (server/workers/syncWorker.js's startHealthServer). Any GET request
# returns 200 while the sync_worker_heartbeat row (updated at the end of
# every poll cycle) is less than 90 seconds old, and 503 otherwise.
# Defaults to 3001 if unset.
SYNC_WORKER_HEALTH_PORT=3001
# Interval, in seconds, between ExpiryScheduler sweeps
# (server/services/ExpiryScheduler.js), running inside the Sync_Worker
# process alongside its poll loop and health server. Each sweep invokes
# VendorChannelService.expireGrants() and
# DeploymentChannelService.deactivateExpired() concurrently. Accepts an
# integer between 60 (1 minute) and 900 (15 minutes) inclusive --
# the 15-minute upper bound is a hard cap, satisfying the vendor grant's
# 15-minute expiry SLA; values outside that range are clamped, and a
# missing/non-numeric value defaults to 900 (15 minutes).
EXPIRY_SCHEDULER_INTERVAL_SECONDS=900

# RETENTION_CLEANUP_INTERVAL_SECONDS: optional. Interval, in seconds,
# between RetentionCleanupJob passes (server/services/RetentionCleanupJob.js),
# which delete expired sync_operations/audit_logs rows per
# SYNC_OPERATIONS_RETENTION_DAYS/AUDIT_LOGS_RETENTION_DAYS below. Clamped
# to a 60 (1 minute) floor; there is no upper bound. Read on the server
# only. Defaults to 86400 (24 hours) if unset.
RETENTION_CLEANUP_INTERVAL_SECONDS=86400

# TAK_ADMIN_CERT_REFRESH_INTERVAL_SECONDS: optional. Interval, in seconds,
# between AdminCredentialRefreshJob passes
# (server/services/AdminCredentialRefreshJob.js), which reload the cached
# TAK Server admin credential (certificate/key/P12) so a rotated credential
# applies without a process restart. Clamped to a 60 (1 minute) floor;
# there is no upper bound. Read on the server only. Defaults to 86400
# (24 hours) if unset.
TAK_ADMIN_CERT_REFRESH_INTERVAL_SECONDS=86400

# Outbound Email (SMTP) Configuration
# Consumed by server/services/EmailService.js (via nodemailer) to send
# verification and notification emails. Generic SMTP settings -- works
# with any SMTP-compatible provider (AWS SES's SMTP interface, Authentik's
# own outbound relay, SendGrid, Mailgun, a self-hosted relay, etc.), not
# tied to any single vendor's SDK/API.
EMAIL_HOST=smtp.example.com
# EMAIL_PORT: typically 587 (STARTTLS) or 465 (implicit TLS/SSL).
# Defaults to 587 if unset.
EMAIL_PORT=587
EMAIL_USERNAME=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
# EMAIL_USE_TLS: upgrade the connection via STARTTLS. Defaults to true;
# set to "false" to skip STARTTLS entirely (rarely appropriate).
EMAIL_USE_TLS=true
# EMAIL_USE_SSL: connect over implicit TLS from the start (SMTPS),
# typically paired with EMAIL_PORT=465. Defaults to false. When true,
# EMAIL_USE_TLS is not consulted (implicit TLS is already in effect).
EMAIL_USE_SSL=false
# EMAIL_TIMEOUT: connection/greeting/socket timeout, in seconds. Defaults
# to 10 if unset.
EMAIL_TIMEOUT=10
EMAIL_FROM="TAK Team Manager <noreply@yourdomain.com>"

# Credential Encryption
# Base64-encoded 32-byte key used by server/services/CredentialEncryptionService.js
# to encrypt BCH service account passwords at rest (AES-256-GCM). Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=your_base64_encoded_32_byte_key

# Secrets Provider
# Read by server/config/secretsProvider.js. Set to "aws-secrets-manager" to
# resolve AUTHENTIK_API_TOKEN, JWT_SECRET, DB_PASSWORD, and EMAIL_PASSWORD
# via AWS Secrets Manager instead of process.env (required in production).
# Leave unset (or any other value) to use process.env directly (dev/test).
SECRETS_PROVIDER=

# Logging Configuration
# Read by server/config/logger.js. One of: debug, info, warn, error.
LOG_LEVEL=info

# Google reCAPTCHA (v3) Configuration
# reCAPTCHA needs BOTH a site key (public) and a secret key (private),
# from the SAME key pair, created as "reCAPTCHA v3" in
# https://www.google.com/recaptcha/admin.
#
# RECAPTCHA_SITE_KEY: read by server/models/SiteConfig.js's
# getPublicConfig() and exposed via GET /api/config/public as
# recaptcha_site_key for the client to load Google's script and call
# grecaptcha.execute(). Safe to expose publicly.
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
# RECAPTCHA_SECRET: read by server/middleware/captcha.js. Secret key used
# to verify the reCAPTCHA v3 response token submitted on
# POST /api/requests/team-access against Google's siteverify API
# (Requirement 7.3/7.4). NEVER expose this to the client. Must be a v3
# key pair -- a v2 secret key will fail verification here.
RECAPTCHA_SECRET=your_recaptcha_secret_key
# Minimum risk score (0.0-1.0; Google's own documented default is 0.5)
# a reCAPTCHA v3 verify response must meet to be treated as human. Values
# outside 0-1, or non-numeric, fall back to the 0.5 default. Optional --
# leave unset to use the default.
RECAPTCHA_MIN_SCORE=0.5
# RECAPTCHA_DISABLED: testing-only bypass for the reCAPTCHA check on
# POST /api/requests/team-access (server/middleware/captcha.js). When set
# to "true", the server skips the CAPTCHA challenge entirely (no token
# required, no call to Google's verify API) and the Client skips loading
# Google's script. Useful when testing against an environment whose
# origin isn't registered/allowed for the configured RECAPTCHA_SITE_KEY
# (e.g. a raw IP address instead of a real domain).
#
# SAFETY: this is HARD-DISABLED whenever NODE_ENV=production, regardless
# of this value -- it can never accidentally leave the CAPTCHA check
# disabled in a production deployment. Leave unset (or "false") normally;
# only set to "true" in a local/dev/test environment.
RECAPTCHA_DISABLED=false

# In-App Settings File Uploads (Requirement 32.4)
# Read by server/routes/settings.js. Directory the atomic logo upload
# (POST /api/settings/branding/logo) writes into; served over HTTP at
# /uploads by server/index.js. Defaults to server/uploads/branding if unset.
UPLOADS_DIR=
# Directory the atomic TAK Server cert/key uploads
# (POST /api/settings/tak-server/cert, /key) write into. NOT served over
# HTTP. Defaults to server/certs/tak-server if unset.
CERTS_DIR=

# Client Build Configuration
# Read by client/src/services/api.js and client/vite.config.js.
# VITE_API_BASE_URL: backend base URL used to build login/API request URLs
# in the built client bundle. Defaults to a same-origin relative path ('')
# when unset.
VITE_API_BASE_URL=
# VITE_DEV_PROXY_TARGET: backend target the Vite dev server proxies /api
# requests to. Only consulted by `vite dev`/`vite serve`, not by the
# production build. Defaults to http://localhost:3000 when unset.
VITE_DEV_PROXY_TARGET=http://localhost:3000
# VITE_START_OVER_URL: external URL the "Start over" link on the
# post-email-submission confirmation screen navigates to. Useful when the
# public sign-up page should link back to the organisation's main website
# rather than reloading itself. Leave unset to default to reloading
# /request-access (resetting the form).
VITE_START_OVER_URL=https://tak.nz

# CloudTAK Integration
# CLOUDTAK_ENABLED: server-side-only flag that turns on the optional
# CloudTAK integration (server/config/cloudtak.js's isCloudTakEnabled).
# When set to "true", every Team/Organisation in the `teams` table is
# mirrored into an Authentik LDAP group named CloudTAKAgency<id> (with
# agencyId/agencyName/description attributes and the Team's direct admins
# as members) via the durable sync_operations queue. Enabled ONLY when
# the value is exactly "true"; unset or any other value (including
# "TRUE"/"1") leaves the feature entirely inert. Read on the server only
# and never exposed through GET /api/config/public. Defaults to false.
CLOUDTAK_ENABLED=false

# CLOUDTAK_AGENCY_GROUP_PREFIX: optional. Authentik group-name prefix used
# for every CloudTAK_Group (server/config/cloudtak.js's
# getCloudTakAgencyGroupPrefix, consumed by
# server/services/CloudTakAgencyGroup.js's groupName). A Team with
# `teams.id` <id> gets a group named exactly `<prefix><id>`, no separator.
# Defaults to "CloudTAKAgency" (the pre-existing hardcoded value) when
# unset or empty. Only meaningful when CLOUDTAK_ENABLED is "true".
#
# This MUST match whatever CloudTAK's own OIDC_AGENCY_ADMIN_GROUP_PREFIX
# is configured to on the CloudTAK side (also defaulting to
# "CloudTAKAgency") -- the two applications share no config source, so a
# mismatch here silently breaks CloudTAK's agency-admin role sync without
# either side erroring.
CLOUDTAK_AGENCY_GROUP_PREFIX=CloudTAKAgency

# CLOUDTAK_URL: optional. Absolute http:// or https:// URL for the
# browser-based CloudTAK client that the Downloads page's CloudTAK_Row
# links to when set (server/utils/cloudtakUrl.js's resolveCloudTakUrl,
# exposed via GET /api/config/public as cloudtak_url). Defaults to unset,
# in which case cloudtak_url resolves to null and the Downloads page omits
# the CloudTAK_Row entirely. A value that is empty, whitespace-only, or
# does not parse as an absolute http/https URL with a non-empty host also
# resolves to null rather than erroring.
#
# INDEPENDENT of CLOUDTAK_ENABLED above: that flag gates an unrelated
# server-side Authentik agency-group sync integration, read by a different
# function (isCloudTakEnabled) that never consults this variable, and this
# variable is read by resolveCloudTakUrl, which never consults
# CLOUDTAK_ENABLED. Setting one has no effect on the other in either
# direction.
CLOUDTAK_URL=

# Device Management
# DEVICE_MGMT_ENABLED: server-side-only flag that turns on the optional TAK
# device-management feature (server/config/deviceMgmt.js's
# isDeviceMgmtEnabled). When set to "true", users can see the TAK Server
# client certificates ("devices") enrolled under their name along with a
# best-effort "last seen" indicator, and can revoke a device's certificate;
# admins get the same view for the users they directly manage. Enabled ONLY
# when the value is exactly "true"; unset or any other value (including
# "TRUE"/"1") leaves the feature entirely inert -- no admin credential is
# loaded, no polling or sync runs, no route or UI surface is reachable, and
# no revocation can be initiated. Optional variable: read on the server only
# and never exposed through GET /api/config/public. Defaults to false.
DEVICE_MGMT_ENABLED=false

# DEVICE_MGMT_REVOKE_ENABLED: server-side-only flag that arms the
# DESTRUCTIVE half of device management -- actually issuing a certificate
# revocation against TAK Server (server/config/deviceMgmt.js's
# isDeviceMgmtRevokeEnabled). It is a SEPARATE, independent variable from
# DEVICE_MGMT_ENABLED with its own default of false: it is never derived
# from or defaulted to that flag, so turning device management on in order
# to LOOK at a device list does not also arm revocation. Reading devices
# needs DEVICE_MGMT_ENABLED alone; issuing a revoke needs BOTH set to
# exactly "true". While this is false, the revoke routes reject with a
# distinct non-404 error and any revoke operation already in the queue
# resolves and logs the certificate ids it WOULD have revoked, then
# completes as a dry-run without issuing the DELETE and without flipping
# any device's revoked flag. Safe to leave "false" -- the device list, the
# "last seen" indicator, polling and sync all work without it. Optional
# variable: read on the server only and never exposed through
# GET /api/config/public. Defaults to false.
DEVICE_MGMT_REVOKE_ENABLED=false

# DEVICE_MGMT_REVOKE_MAX_CERTS: bounds the blast radius of a SINGLE revoke
# operation -- the maximum number of certificates one operation may target.
# The resolved target count is checked against this cap before the DELETE
# is issued; exceeding it aborts the whole operation. The target set is
# never truncated to the cap, because a partial revocation would report a
# device as disabled while leaving it able to connect. The default of 250
# sits above the largest real per-device certificate count observed on the
# live server (60 certificates on "ckadmin (ETL)"), so a re-enrollment-heavy
# device is not blocked by the rail that exists to catch a runaway
# resolution. Optional variable: read on the server only and never exposed
# through GET /api/config/public. Defaults to 250.
DEVICE_MGMT_REVOKE_MAX_CERTS=250

# DEVICE_MGMT_POLL_INTERVAL_SECONDS: optional. Interval, in seconds, between
# SubscriptionPoller polls of TAK Server's Client_Endpoints_API
# (server/services/SubscriptionPoller.js), which is how each device's
# Last_Seen and Connection_Status get updated. Clamped to a 60 (1 minute)
# floor -- values below that are raised to it; there is no upper bound.
# Read on the server only. Defaults to 300 (5 minutes) if unset.
DEVICE_MGMT_POLL_INTERVAL_SECONDS=300

# DEVICE_MGMT_SYNC_INTERVAL_SECONDS: optional. Interval, in seconds, between
# DeviceSync runs (server/services/DeviceSync.js), which upsert each
# Device's certificate metadata (issued/expires) from TAK Server's
# certadmin API. Clamped between 60 (1 minute) and 86400 (24 hours)
# inclusive; values outside that range are clamped. Read on the server
# only. Defaults to 900 (15 minutes) if unset.
DEVICE_MGMT_SYNC_INTERVAL_SECONDS=900

# DEVICE_MGMT_EXPIRY_WARNING_DAYS: optional. Number of days ahead of a device
# certificate's expiry at which that device's "Expires" value starts being
# drawn as an imminent expiry -- bold, red, and carrying a text marker a screen
# reader announces. Read by server/models/SiteConfig.js's getPublicConfig() and
# exposed via GET /api/config/public as device_expiry_warning_days for the
# shared device-list row component to render from. Defaults to 30; an unset,
# empty, non-numeric, zero or negative value also yields 30, and the Client
# falls back to 30 when it cannot reach that endpoint.
#
# Unlike the device-management variables above, this one IS exposed to the
# client -- it controls only how a date is DRAWN. It arms nothing, gates
# nothing, and is not read anywhere on the server: the device read path has no
# expiry filter, so raising or lowering it changes no query, hides no device,
# and revokes nothing. The two flags above stay server-side precisely because
# they are not like this.
DEVICE_MGMT_EXPIRY_WARNING_DAYS=30

# TAK_SERVER_ENROLLMENT_URL: the TAK Server hostname a CLIENT DEVICE should
# dial for enrollment and streaming (server/services/DeviceEnrollmentService.js),
# read to build the ATAK deep-link URI and the iTAK registration payload's
# `connectionString` on the Enrollment_View (client/src/pages/EnrollmentView.jsx).
#
# DELIBERATELY SEPARATE from TAK_SERVER_URL above: that variable is the Marti
# certadmin API's mutual-TLS endpoint, which this application dials on the
# server side and which is often an internal/admin address (e.g. port 8443
# behind a private network) -- NOT the public-facing name a phone or tablet
# should enroll against (typically port 8089, reachable from the client's own
# network). Where the two names differ, using TAK_SERVER_URL for enrollment
# would generate a QR code that enrolls a device against an address it cannot
# actually reach.
#
# An absolute http/https URL (only its hostname is used; scheme and port are
# ignored -- ENROLLMENT_PORT 8089 is a code constant, never read from here).
# Required for the enrollment feature: left unset, POST /api/enrollment/me and
# POST /api/devices/:deviceUserId/qr-code both reject with 400
# (TakServerNotConfiguredError) rather than falling back to TAK_SERVER_URL.
TAK_SERVER_ENROLLMENT_URL=

# WINTAK_MANUAL_DESCRIPTION: optional. Label shown as "Description" on
# the Enrollment_View's WinTAK/Manual tab (client/src/pages/EnrollmentView.jsx),
# exposed via GET /api/config/public as enrollment_manual_description
# (server/models/SiteConfig.js). Purely presentational -- deployment-specific
# display text, arms no capability, and is not read anywhere else
# server-side. Defaults to "TAK.NZ". (Named WINTAK_ rather than ENROLLMENT_:
# that prefix is reserved for takserver-enrollment's own constants, see
# server/config/__tests__/enrollmentPermissions.test.js.)
WINTAK_MANUAL_DESCRIPTION=TAK.NZ

# TAK Server TLS Server Identity
# TAK_SERVER_TLS_SERVERNAME: optional. Name that TAK Server's own TLS server
# certificate is verified against by the mutual-TLS agent in
# server/services/TakServerService.js (buildMutualTlsAgentOptions). A stock
# TAK Server certificate carries CN=takserver with a single DNS:takserver SAN
# -- not the DNS name operators actually dial, which is typically a load
# balancer in front of it -- so Node's default identity check against the host
# of TAK_SERVER_URL fails with ERR_TLS_CERT_ALTNAME_INVALID on every request.
# Set this to the name the certificate really carries (typically "takserver")
# to point the identity check at it.
#
# This narrows WHICH name is verified; it does NOT weaken verification. TAK
# Server's certificate chain is still verified against the CA bundle from
# TAK_CA_PATH, rejectUnauthorized is never disabled, and no
# checkServerIdentity override is ever used.
#
# Leave unset (or empty) to keep the current behavior exactly -- identity
# verified against the host of TAK_SERVER_URL -- which is correct for any
# deployment whose TAK Server certificate already matches the dialed name.
TAK_SERVER_TLS_SERVERNAME=
