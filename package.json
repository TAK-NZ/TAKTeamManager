{
  "name": "tak-team-manager",
  "version": "2026.9.0",
  "description": "Manage TAK teams, users, and channels via Authentik",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:init-db": "docker compose exec app node database/init.js",
    "migrate": "node-pg-migrate --config-file database/migrate-config.js",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "migrate:create": "npm run migrate -- create",
    "cloudtak:backfill": "node scripts/create-cloudtak-groups.js",
    "sync:users": "node -e \"require('./server/services/authentikSync').syncUsers().then(() => process.exit(0)).catch((e) => { console.error(e); process.exit(1); })\"",
    "test": "jest --forceExit",
    "lint": "eslint server scripts database eslint.config.js",
    "lint:pinned-deps": "node scripts/check-pinned-deps.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1109.0",
    "@aws-sdk/client-secrets-manager": "3.1109.0",
    "@aws-sdk/s3-request-presigner": "3.1109.0",
    "archiver": "7.0.1",
    "axios": "^1.6.0",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "7.0.2",
    "csv-stringify": "6.8.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "7.5.1",
    "express-validator": "^7.0.1",
    "helmet": "7.2.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.2.0",
    "node-forge": "1.4.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "9.0.5",
    "p-limit": "3.1.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.3",
    "pino": "10.3.1",
    "qrcode": "^1.5.4",
    "sanitize-html": "2.17.5"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fast-check/jest": "2.2.0",
    "adm-zip": "0.6.0",
    "concurrently": "^8.2.2",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "keywords": [
    "tak",
    "team-management",
    "authentik",
    "ldap"
  ],
  "author": "TAK-NZ",
  "license": "AGPL-3.0",
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/client/",
      "\\.integration\\.test\\.js$"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 60
      }
    }
  }
}
