{
  "testEnvironment": "node",
  "roots": ["<rootDir>/test"],
  "testMatch": ["**/*.test.ts"],
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/test/__helpers__/",
    "/test/__fixtures__/"
  ],
  "transform": {
    "^.+\\.ts$": ["@swc/jest"]
  },
  "coverageReporters": ["text"],
  "collectCoverageFrom": ["lib/**/*.ts", "!lib/**/*.d.ts"],
  "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json", "node"]
}
